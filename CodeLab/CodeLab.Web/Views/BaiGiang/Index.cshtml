@model List<BaiGiang>
@{
    var tenKhoaHoc = (Dictionary<int, string>)ViewBag.TenKhoaHoc;
    var tenChuong = (Dictionary<int, string>)ViewBag.TenChuong;
}
<h1>Bài giảng</h1>
<a class="btn btn-primary mb-3" asp-action="Edit">Thêm mới</a> <a asp-controller="QuanTri" asp-action="Index">Về quản trị</a>
<div class="table-responsive">
<table class="table">
<thead>
<tr>
<th>Mã</th>
<th>Chương</th>
<th>Khóa học</th>
<th>Tên bài giảng</th>
<th>Cho học thử</th>
<th>Thứ tự</th>
 <th>Bắt buộc</th>
<th>Thao tác</th>
</tr>
</thead>
<tbody>@foreach(var row in Model) { <tr>
<td>@row.MaBaiGiang</td>
<td>@tenChuong.GetValueOrDefault(row.MaChuong, "Chưa rõ chương")</td>
<td>@tenKhoaHoc.GetValueOrDefault(row.MaKhoaHoc, "Chưa rõ khóa học")</td>
<td>@row.TenBaiGiang</td>
<td>@row.HocThu</td>
 <td>@row.ThuTu</td>
<td>@row.BatBuoc</td>
<td>
<a asp-controller="Video" asp-action="Them" asp-route-id="@row.MaBaiGiang">Video</a> · <a asp-controller="TaiLieu" asp-action="Index" asp-route-id="@row.MaBaiGiang">Tài liệu</a> <a asp-action="Edit" asp-route-id="@row.MaBaiGiang">Sửa</a>
</td>
</tr>}</tbody>
</table>
</div>