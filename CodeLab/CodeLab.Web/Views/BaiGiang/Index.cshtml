@model List<BaiGiang>
@{
    var tenKhoaHoc = (Dictionary<int, string>)ViewBag.TenKhoaHoc;
    var tenChuong = (Dictionary<int, string>)ViewBag.TenChuong;
    var maKhoaHocDaChon = (int?)ViewBag.MaKhoaHocDaChon;
}
<h1>Bài giảng</h1>
<a class="btn btn-primary mb-3" asp-action="Edit">Thêm mới</a> <a asp-controller="QuanTri" asp-action="Index">Về quản trị</a>
<div class="table-responsive">
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <label for="tuKhoa" class="form-label">Từ khóa</label>
            <input type="search" id="tuKhoa" name="tuKhoa"
                   value="@ViewBag.TuKhoa" class="form-control"
                   placeholder="Tên bài giảng, chương hoặc khóa học" />
        </div>

        <div class="col-md-4">
            <label for="maKhoaHoc" class="form-label">Khóa học</label>
            <select id="maKhoaHoc" name="maKhoaHoc" class="form-select">
                <option value="">Tất cả khóa học</option>
                @foreach (var khoa in tenKhoaHoc.OrderBy(khoa => khoa.Value))
                {
                    <option value="@khoa.Key" selected="@(maKhoaHocDaChon == khoa.Key)">
                        @khoa.Value
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <p class="alert alert-info">Không tìm thấy bài giảng phù hợp.</p>
    }
<table class="table">
<thead>
<tr>
<th>Mã</th>
<th>Chương</th>
<th>Khóa học</th>
<th>Tên bài giảng</th>
<th>Cho học thử</th>
<th>Thứ tự</th>
 <th>Bắt buộc</th>
<th>Thao tác</th>
</tr>
</thead>
<tbody>@foreach(var row in Model) { <tr>
<td>@row.MaBaiGiang</td>
<td>@tenChuong.GetValueOrDefault(row.MaChuong, "Chưa rõ chương")</td>
<td>@tenKhoaHoc.GetValueOrDefault(row.MaKhoaHoc, "Chưa rõ khóa học")</td>
<td>@row.TenBaiGiang</td>
<td>@row.HocThu</td>
 <td>@row.ThuTu</td>
<td>@row.BatBuoc</td>
<td>
<a asp-controller="Video" asp-action="Them" asp-route-id="@row.MaBaiGiang">Video</a> · <a asp-controller="TaiLieu" asp-action="Index" asp-route-id="@row.MaBaiGiang">Tài liệu</a> <a asp-action="Edit" asp-route-id="@row.MaBaiGiang">Sửa</a>
</td>
</tr>}</tbody>
</table>
</div>