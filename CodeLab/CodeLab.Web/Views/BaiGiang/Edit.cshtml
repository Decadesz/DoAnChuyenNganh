@model BaiGiangInput
<div class="editor">
<h1>@(Model.MaBaiGiang==0 ? "Thêm" : "Sửa") bài giảng</h1>
<form method="post" asp-action="Edit" asp-route-id="@Model.MaBaiGiang">
<div asp-validation-summary="All">
</div>
<input type="hidden" asp-for="MaBaiGiang" />
@* Gửi mã phiên bản của bài để EF Core phát hiện khi bài đã được người khác cập nhật. *@
<input type="hidden" asp-for="Version" />
<div>
<label asp-for="MaChuong"></label>
<select class="form-select" asp-for="MaChuong" asp-items="ViewBag.Chapters">
<option value="">-- Chọn --</option>
</select>
<span asp-validation-for="MaChuong">
</span>
</div>
<div>
<label asp-for="MaKhoaHoc"></label>
<select class="form-select" asp-for="MaKhoaHoc" asp-items="ViewBag.Courses">
<option value="">-- Chọn --</option>
</select>
<span asp-validation-for="MaKhoaHoc">
</span>
</div>
<div>
<label asp-for="TenBaiGiang"></label>
<input class="form-control" asp-for="TenBaiGiang" />
<span asp-validation-for="TenBaiGiang">
</span>
</div>
<div>
<label asp-for="NoiDung"></label>
<textarea rows="6" class="form-control" asp-for="NoiDung">
</textarea>
<span asp-validation-for="NoiDung">
</span>
</div>
<div>
<label asp-for="DuongDanVideo"></label>
<input class="form-control" asp-for="DuongDanVideo" />
<span asp-validation-for="DuongDanVideo">
</span>
</div>
<div>
<label asp-for="HocThu"></label> <input class="form-check-input" asp-for="HocThu" />
<span asp-validation-for="HocThu">
</span>
</div>
<div>
<label asp-for="BatBuoc"></label> <input class="form-check-input" asp-for="BatBuoc" />
<span asp-validation-for="BatBuoc">
</span>
</div>
<div>
<label asp-for="HienThi"></label> <input class="form-check-input" asp-for="HienThi" />
<span asp-validation-for="HienThi">
</span>
</div>
<div>
<label asp-for="ThuTu"></label>
<input class="form-control" asp-for="ThuTu" />
<span asp-validation-for="ThuTu">
</span>
</div>
<button class="btn btn-primary mt-4">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary mt-4">Quay lại</a>
</form>
</div>