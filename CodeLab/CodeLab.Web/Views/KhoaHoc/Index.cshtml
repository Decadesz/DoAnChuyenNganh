@model List<KhoaHoc>
@{ ViewData["Title"] = "Quản lý khóa học"; var languages = (Dictionary<int,string>)ViewBag.Languages; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý khóa học</h1>
    <a class="btn btn-primary" asp-action="Create">Thêm khóa học</a>
</div>
<form asp-controller="KhoaHoc" asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-6"><label for="q" class="form-label">Tên khóa học</label><input id="q" name="q" class="form-control" value="@Context.Request.Query["q"]" /></div>
    <div class="col-md-4"><label for="status" class="form-label">Trạng thái</label><select id="status" name="status" class="form-select">
        <option value="">Tất cả</option>
        <option value="hidden" selected="@(Context.Request.Query["status"] == "hidden")">Đang ẩn</option>
        <option value="closed" selected="@(Context.Request.Query["status"] == "closed")">Hiển thị, chưa mở bán</option>
        <option value="open" selected="@(Context.Request.Query["status"] == "open")">Hiển thị, mở bán</option>
    </select></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary">Tìm kiếm</button></div>
</form>
@if(Model.Count == 0) { <p class="alert alert-info">Không có khóa học phù hợp.</p> }
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Mã</th><th>Khóa học</th><th>Ngôn ngữ</th><th>Học phí</th><th>Hiển thị</th><th>Mở bán</th><th>Thao tác</th></tr></thead>
    <tbody>@foreach(var c in Model)
    {
        <tr><td>@c.MaKhoaHoc</td><td>@c.TenKhoaHoc<br /><small>@c.TrinhDo</small></td>
        <td>@languages.GetValueOrDefault(c.MaNgonNgu, "—")</td><td>@c.HocPhi.ToString("N0") đ</td>
        <td>@(c.HienThi ? "Hiển thị" : "Ẩn")</td><td>@(c.MoBan ? "Mở bán" : "Đóng bán")</td>
        <td><div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.MaKhoaHoc">Sửa</a>
        <a class="btn btn-sm btn-outline-secondary" asp-action="TrangThai" asp-route-id="@c.MaKhoaHoc">Trạng thái</a>
        @if(c.HienThi) { <a class="btn btn-sm btn-link" asp-controller="Home" asp-action="ChiTiet" asp-route-id="@c.MaKhoaHoc">Xem trang công khai</a> }
        </div></td></tr>
    }</tbody></table></div>
}
