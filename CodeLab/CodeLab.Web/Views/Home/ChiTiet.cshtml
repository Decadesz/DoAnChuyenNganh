@model KhoaHoc
@{ var chuong = (List<ChuongHoc>)ViewBag.Chuong;
   var bai = (List<LessonOutline>)ViewBag.Bai; }
@{ ViewData["Title"] = Model.TenKhoaHoc; }
<a asp-action="Index">← Danh sách khóa học</a>
<section class="card course-detail-hero">
<h1>@Model.TenKhoaHoc</h1>
@if(Uri.TryCreate(Model.HinhDaiDien, UriKind.Absolute, out var imageUri) && imageUri.Scheme == "https")
{
    <img src="@imageUri.AbsoluteUri" alt="Ảnh khóa học @Model.TenKhoaHoc" class="img-fluid rounded mb-3" style="max-height:320px" referrerpolicy="no-referrer" />
}
<p>@Model.MoTaNgan</p>
@if(!string.IsNullOrWhiteSpace(Model.MoTaChiTiet))
{
    <div class="lesson">@Model.MoTaChiTiet</div>
}
<dl class="course-facts">
    <div><dt>Trình độ</dt><dd>@Model.TrinhDo</dd></div>
    <div><dt>Học phí</dt><dd>@(Model.HocPhi == 0 ? "Miễn phí" : Model.HocPhi.ToString("N0") + " đ")</dd></div>
    <div><dt>Trạng thái</dt><dd>@(Model.MoBan ? "Đang mở bán" : "Chưa mở bán / tạm ngừng bán")</dd></div>
</dl>
</section>
<h2>Lộ trình khóa học</h2>
@if(chuong.Count == 0) { <p>Lộ trình đang được cập nhật.</p> }
@foreach(var chapter in chuong)
{
    <section class="card chapter-card">
        <h3>@chapter.ThuTu. @chapter.TenChuong</h3>
        <ol>
        @foreach(var lesson in bai.Where(x => x.MaChuong == chapter.MaChuong))
        {
            <li>
                @* Hiện liên kết khi bài học thử hoặc tài khoản đủ quyền. Action BaiGiang sẽ kiểm tra lại ở máy chủ. *@
                @if (lesson.HocThu || ViewBag.CoQuyen == true || User.IsInRole("Admin"))
                {
                    <a asp-controller="HocTap" asp-action="BaiGiang" asp-route-id="@lesson.MaBaiGiang">@lesson.TenBaiGiang</a>
                    @* Hiện liên kết khi bài học thử hoặc tài khoản đủ quyền. Action BaiGiang sẽ kiểm tra lại ở máy chủ. *@
                    @if (lesson.HocThu) { <small class="trial-tag">Học thử</small> }
                }
                else { <span>@lesson.TenBaiGiang · Dành cho học viên đã có quyền</span> }
            </li>
        }
        </ol>
    </section>
}
