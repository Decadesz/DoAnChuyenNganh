@model List<KhoaHoc>
<section class="hero">
<div class="text-uppercase mb-2">Bắt đầu từ nền tảng</div>
<h1>Khám phá khóa học.<br />Bắt đầu với lộ trình phù hợp.</h1>
<p>Tìm hiểu nội dung và lộ trình các khóa học lập trình cho người mới.</p>
</section>
<form method="get" class="d-flex gap-2 mb-4">
<input class="form-control" name="q" placeholder="Tìm khóa học…" value="@Context.Request.Query["q"]" />
<select class="form-select" name="language">
<option value="">Tất cả ngôn ngữ</option>@foreach(NgonNguLapTrinh n in ViewBag.Languages){<option value="@n.MaNgonNgu" selected="@(Context.Request.Query["language"]==n.MaNgonNgu.ToString())">@n.TenNgonNgu</option>}</select>
<button class="btn btn-primary">Tìm</button>
</form>
@if(Model.Count==0){<div class="alert alert-info">Chưa có khóa học hiển thị phù hợp.</div>}
<div class="row g-4">@foreach(var c in Model){<div class="col-md-6 col-lg-4">
<article class="card h-100">
<div class="card-body">
<span class="badge bg-primary">@c.TrinhDo</span>
<h2>@c.TenKhoaHoc</h2>
<p>@c.MoTaNgan</p>
<p class="fw-bold">@c.HocPhi.ToString("N0") đ</p>
<a class="btn btn-outline-primary" asp-action="ChiTiet" asp-route-id="@c.MaKhoaHoc">Xem khóa học</a>
</div>
</article>
</div>}</div>