<!doctype html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Khóa học lập trình") · CodeLab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="container shell-nav" aria-label="Điều hướng chính">
            <a class="brand" asp-controller="Home" asp-action="Index"><span aria-hidden="true">&gt;_</span> CodeLab</a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">Khóa học</a>
                @* Lấy vai trò từ Identity để chọn menu. Controller kiểm tra lại quyền khi nhận yêu cầu. *@
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="KhoaHoc" asp-action="Index">Quản lý khóa học</a>
                    <a asp-controller="ChuongHoc" asp-action="Index">Chương học</a>
                    <a asp-controller="BaiGiang" asp-action="Index">Bài giảng</a>
                    <a asp-controller="QuanTri" asp-action="TaiKhoan">Học viên</a>
                }
            </div>
            <div class="nav-account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="account-name" title="@User.Identity.Name">@User.Identity.Name</span>
                    <a asp-controller="TaiKhoan" asp-action="DoiMatKhau">Đổi mật khẩu</a>
                    <form method="post" asp-controller="TaiKhoan" asp-action="DangXuat">
                        <button class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                    <a class="btn btn-primary btn-sm" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
                }
            </div>
        </nav>
    </header>
    <main class="container site-main">
        @* TempData mang thông báo từ action ghi dữ liệu sang trang sau khi chuyển hướng. *@
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-info" role="status">@message</div>
        }
        @RenderBody()
    </main>
    <footer class="container site-footer">CodeLab · Học lập trình trực tuyến</footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
