@model ChangePasswordInput
<div class="editor auth-panel">
<a class="brand" asp-controller="Home" asp-action="Index"><span aria-hidden="true">&gt;_</span> CodeLab</a>
<h1>Đổi mật khẩu</h1>
<form method="post" asp-action="DoiMatKhau">
<div asp-validation-summary="All"></div>
<label asp-for="OldPassword"></label>
<input class="form-control" asp-for="OldPassword" autocomplete="current-password" />
<label asp-for="NewPassword"></label>
<input class="form-control" asp-for="NewPassword" autocomplete="new-password" />
<label asp-for="ConfirmPassword"></label>
<input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
<button class="btn btn-primary mt-4">Lưu mật khẩu</button>
</form>
</div>